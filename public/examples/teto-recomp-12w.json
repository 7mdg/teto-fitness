{
  "$schema": "https://7mdg.github.io/teto-fitness/schemas/teto-plan.v1.schema.json",
  "format": "teto-plan",
  "schemaVersion": "1.0.0",
  "metadata": {
    "id": "teto-recomp-12w",
    "revision": 1,
    "name": "12 Week Body Recomposition",
    "author": "TETO",
    "description": "Upper/lower split, 4 days a week. Weeks 1–3 at 2 working sets, full volume from week 4. Double progression.",
    "createdAt": "2026-11-24"
  },
  "goals": { "primary": "body_recomposition", "priorities": ["Chest", "Biceps thickness", "Shoulder width", "Back width"] },
  "programme": {
    "durationWeeks": 12,
    "startDate": "2026-11-30",
    "onCompletion": "continue",
    "phases": [
      { "id": "intro", "name": "Introduction", "startWeek": 1, "endWeek": 3, "workingSetsCap": 2, "targetRir": 3, "notes": "Learn the movements and find working weights." },
      { "id": "progression", "name": "Progression", "startWeek": 4, "endWeek": 12, "targetRir": 2 }
    ]
  },
  "exercises": [
    { "id": "incline-dumbbell-press", "name": "Incline dumbbell press", "tracking": "strength", "equipment": "dumbbell", "category": "compound", "muscleGroups": ["chest", "triceps", "shoulders"], "weightMode": "per_dumbbell", "defaultRestSeconds": 120, "weightIncrementKg": 2, "alternatives": ["incline-chest-press", "incline-smith-press"] },
    { "id": "machine-chest-press", "name": "Machine chest press", "tracking": "strength", "equipment": "machine", "category": "compound", "muscleGroups": ["chest", "triceps", "shoulders"], "weightMode": "total", "defaultRestSeconds": 120, "weightIncrementKg": 5, "alternatives": ["dumbbell-bench-press", "smith-bench-press"] },
    { "id": "lat-pulldown", "name": "Lat pulldown", "tracking": "strength", "equipment": "cable", "category": "compound", "muscleGroups": ["back", "biceps"], "weightMode": "total", "defaultRestSeconds": 120, "weightIncrementKg": 2.5, "alternatives": ["machine-pulldown", "assisted-pull-up"] },
    { "id": "cable-lateral-raise", "name": "Cable lateral raises", "tracking": "strength", "equipment": "cable", "category": "isolation", "muscleGroups": ["shoulders"], "weightMode": "per_side", "unilateral": true, "sideLogging": "combined", "defaultRestSeconds": 90, "weightIncrementKg": 1.25, "alternatives": ["dumbbell-lateral-raise", "machine-lateral-raise"] },
    { "id": "hammer-curl", "name": "Hammer curls", "tracking": "strength", "equipment": "dumbbell", "category": "isolation", "muscleGroups": ["biceps", "brachialis", "forearms"], "weightMode": "per_dumbbell", "defaultRestSeconds": 90, "weightIncrementKg": 1, "alternatives": ["cable-rope-hammer-curl"] },
    { "id": "triceps-pushdown", "name": "Triceps pushdown", "tracking": "strength", "equipment": "cable", "category": "isolation", "muscleGroups": ["triceps"], "weightMode": "total", "defaultRestSeconds": 90, "weightIncrementKg": 2.5, "alternatives": ["overhead-triceps-extension", "machine-dip"] },
    { "id": "leg-press", "name": "Leg press", "tracking": "strength", "equipment": "machine", "category": "compound", "muscleGroups": ["quads", "glutes"], "weightMode": "total", "defaultRestSeconds": 120, "weightIncrementKg": 5, "alternatives": ["hack-squat", "smith-squat"] },
    { "id": "romanian-deadlift", "name": "Romanian deadlift", "tracking": "strength", "equipment": "barbell", "category": "compound", "muscleGroups": ["hamstrings", "glutes", "lower-back"], "weightMode": "total", "defaultRestSeconds": 120, "weightIncrementKg": 5, "notes": "Weight includes the bar.", "alternatives": ["dumbbell-romanian-deadlift"] },
    { "id": "leg-extension", "name": "Leg extension", "tracking": "strength", "equipment": "machine", "category": "isolation", "muscleGroups": ["quads"], "weightMode": "total", "defaultRestSeconds": 90, "weightIncrementKg": 2.5, "alternatives": ["single-leg-extension"] },
