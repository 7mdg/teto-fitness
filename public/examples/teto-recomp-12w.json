    { "id": "preacher-curl", "name": "Preacher curls", "tracking": "strength", "equipment": "machine", "category": "isolation", "muscleGroups": ["biceps"], "weightMode": "total", "defaultRestSeconds": 90, "weightIncrementKg": 2.5, "alternatives": ["ez-bar-preacher-curl", "cable-curl"] },
    { "id": "overhead-triceps-extension", "name": "Overhead triceps extension", "tracking": "strength", "equipment": "cable", "category": "isolation", "muscleGroups": ["triceps"], "weightMode": "total", "defaultRestSeconds": 90, "weightIncrementKg": 2.5, "alternatives": ["triceps-pushdown", "dumbbell-overhead-extension"] },
    { "id": "cable-crunch", "name": "Cable crunch", "tracking": "strength", "equipment": "cable", "category": "isolation", "muscleGroups": ["abs"], "weightMode": "total", "defaultRestSeconds": 90, "weightIncrementKg": 2.5, "alternatives": ["machine-crunch"] },

    { "id": "incline-smith-press", "name": "Incline Smith press", "tracking": "strength", "equipment": "smith", "category": "compound", "muscleGroups": ["chest", "triceps", "shoulders"], "weightMode": "total", "defaultRestSeconds": 120, "weightIncrementKg": 5 },
    { "id": "dumbbell-bench-press", "name": "Dumbbell bench press", "tracking": "strength", "equipment": "dumbbell", "category": "compound", "muscleGroups": ["chest", "triceps", "shoulders"], "weightMode": "per_dumbbell", "defaultRestSeconds": 120, "weightIncrementKg": 2 },
