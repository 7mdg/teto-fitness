{
  "$schema": "https://7mdg.github.io/teto-fitness/schemas/teto-plan.v1.schema.json",
  "format": "teto-plan",
  "schemaVersion": "1.0.0",
  "metadata": {
    "id": "full-body-3d-home",
    "revision": 1,
    "name": "Full Body at Home",
    "author": "TETO example",
    "description": "Three 40-minute full-body sessions a week with dumbbells only. Workouts A and B alternate week by week.",
    "createdAt": "2026-11-24"
  },
  "goals": { "primary": "general_fitness" },
  "programme": { "durationWeeks": 8, "onCompletion": "continue" },
  "exercises": [
    { "id": "goblet-squat", "name": "Goblet squat", "tracking": "strength", "equipment": "dumbbell", "category": "compound", "muscleGroups": ["quads", "glutes"], "weightMode": "total", "defaultRestSeconds": 90, "weightIncrementKg": 2, "alternatives": ["bulgarian-split-squat"] },
    { "id": "bulgarian-split-squat", "name": "Bulgarian split squat", "tracking": "strength", "equipment": "dumbbell", "category": "compound", "muscleGroups": ["quads", "glutes"], "weightMode": "per_dumbbell", "unilateral": true, "sideLogging": "separate", "defaultRestSeconds": 90, "weightIncrementKg": 2 },
    { "id": "dumbbell-floor-press", "name": "Dumbbell floor press", "tracking": "strength", "equipment": "dumbbell", "category": "compound", "muscleGroups": ["chest", "triceps"], "weightMode": "per_dumbbell", "defaultRestSeconds": 90, "weightIncrementKg": 2, "alternatives": ["push-up"] },
    { "id": "push-up", "name": "Push-up", "tracking": "bodyweight", "equipment": "bodyweight", "category": "compound", "muscleGroups": ["chest", "triceps", "shoulders"], "weightMode": "added", "defaultRestSeconds": 60 },
    { "id": "dumbbell-row", "name": "One-arm dumbbell row", "tracking": "strength", "equipment": "dumbbell", "category": "compound", "muscleGroups": ["back", "rear-delts", "biceps"], "weightMode": "per_dumbbell", "unilateral": true, "defaultRestSeconds": 90, "weightIncrementKg": 2 },
    { "id": "dumbbell-romanian-deadlift", "name": "Dumbbell Romanian deadlift", "tracking": "strength", "equipment": "dumbbell", "category": "compound", "muscleGroups": ["hamstrings", "glutes", "lower-back"], "weightMode": "per_dumbbell", "defaultRestSeconds": 90, "weightIncrementKg": 2 },
    { "id": "dumbbell-shoulder-press", "name": "Seated dumbbell shoulder press", "tracking": "strength", "equipment": "dumbbell", "category": "compound", "muscleGroups": ["shoulders", "triceps"], "weightMode": "per_dumbbell", "defaultRestSeconds": 90, "weightIncrementKg": 2 },
    { "id": "dumbbell-lateral-raise", "name": "Lateral raises", "tracking": "strength", "equipment": "dumbbell", "category": "isolation", "muscleGroups": ["shoulders"], "weightMode": "per_dumbbell", "defaultRestSeconds": 60, "weightIncrementKg": 1 },
    { "id": "hammer-curl", "name": "Hammer curls", "tracking": "strength", "equipment": "dumbbell", "category": "isolation", "muscleGroups": ["biceps", "brachialis", "forearms"], "weightMode": "per_dumbbell", "defaultRestSeconds": 60, "weightIncrementKg": 1 },
    { "id": "plank", "name": "Plank", "tracking": "isometric", "equipment": "bodyweight", "category": "isolation", "muscleGroups": ["abs"], "defaultRestSeconds": 60 },
    { "id": "brisk-walk", "name": "Brisk walk", "tracking": "cardio", "equipment": "other", "muscleGroups": ["cardio"] }
  ],
  "workouts": [
    {
      "id": "full-a",
      "name": "Full body A",
      "estimatedDurationMinutes": 40,
      "exercises": [
        { "exerciseId": "goblet-squat", "sets": 3, "repsMin": 8, "repsMax": 12 },
        { "exerciseId": "dumbbell-floor-press", "sets": 3, "repsMin": 8, "repsMax": 12 },
        { "exerciseId": "dumbbell-row", "sets": 3, "repsMin": 10, "repsMax": 12 },
        { "exerciseId": "dumbbell-lateral-raise", "sets": 2, "repsMin": 12, "repsMax": 20 },
        { "exerciseId": "plank", "sets": 3, "durationSec": 40 }
      ]
    },
    {
      "id": "full-b",
      "name": "Full body B",
      "estimatedDurationMinutes": 40,
      "exercises": [
        { "exerciseId": "dumbbell-romanian-deadlift", "sets": 3, "repsMin": 8, "repsMax": 12 },
        { "exerciseId": "dumbbell-shoulder-press", "sets": 3, "repsMin": 8, "repsMax": 12 },
        { "exerciseId": "push-up", "sets": 3, "repsMin": 6, "repsMax": 15 },
        { "exerciseId": "hammer-curl", "sets": 2, "repsMin": 10, "repsMax": 15 },
        { "exerciseId": "brisk-walk", "sets": 1, "durationSec": 900, "optional": true }
      ]
    }
  ],
  "schedule": {
    "timezone": "Europe/Brussels",
    "weekStartsOn": "monday",
    "entries": [
      { "id": "mon-a", "workoutId": "full-a", "weekday": "monday", "time": "18:30", "everyNWeeks": 2, "weekOffset": 0 },
      { "id": "wed-b", "workoutId": "full-b", "weekday": "wednesday", "time": "18:30", "everyNWeeks": 2, "weekOffset": 0 },
      { "id": "fri-a", "workoutId": "full-a", "weekday": "friday", "time": "18:30", "everyNWeeks": 2, "weekOffset": 0 },
      { "id": "mon-b", "workoutId": "full-b", "weekday": "monday", "time": "18:30", "everyNWeeks": 2, "weekOffset": 1 },
      { "id": "wed-a", "workoutId": "full-a", "weekday": "wednesday", "time": "18:30", "everyNWeeks": 2, "weekOffset": 1 },
      { "id": "fri-b", "workoutId": "full-b", "weekday": "friday", "time": "18:30", "everyNWeeks": 2, "weekOffset": 1 }
    ]
  },
  "habits": [
    { "id": "daily-steps", "name": "8,000 steps", "type": "count", "target": { "min": 8000, "unit": "steps" }, "frequency": "daily" },
    { "id": "weekly-weigh-in", "name": "Weekly weigh-in", "type": "measurement", "measurementId": "bodyweight", "frequency": "weekly" }
  ],
  "measurements": [{ "id": "bodyweight", "name": "Body weight", "unit": "kg", "frequency": "weekly", "trend": "rolling7" }],
  "reminders": { "workout": { "enabled": true, "offsetsMinutes": [60] } },
  "preferences": { "weightUnit": "kg", "progressionMethod": "double_progression", "restTimerEnabled": true }
}
